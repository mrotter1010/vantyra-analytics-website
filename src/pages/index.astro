    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="fade-in-section scroll-mt-20 bg-vantyra-bg-s py-12">
    <div class="mx-auto max-w-6xl px-6">
      <div class="section-divider"></div>
      <p class="text-sm uppercase tracking-widest text-vantyra-accent mb-3">Get in Touch</p>
      <h2 class="text-4xl md:text-5xl font-bold tracking-tight text-vantyra-text mb-4">Contact</h2>
      <p class="text-lg text-vantyra-text-s leading-relaxed max-w-3xl mb-12">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
      </p>

      <!-- Calendly placeholder -->
      <div class="flex min-h-[600px] flex-col items-center justify-center rounded-xl border border-vantyra-border bg-vantyra-bg p-6">
