    <div class="mx-auto max-w-6xl px-6">
      <div class="section-divider"></div>
      <p class="text-sm uppercase tracking-widest text-vantyra-accent mb-3">What We Do</p>
      <h2 class="text-4xl md:text-5xl font-bold tracking-tight text-vantyra-text mb-4">Use Cases</h2>
      <p class="text-lg text-vantyra-text-s leading-relaxed max-w-3xl mb-12">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
      </p>
      <div class="grid gap-8 md:grid-cols-3">
        <div class="card-glow bg-vantyra-bg-s rounded-xl border border-vantyra-border p-6 transition-all duration-200 hover:border-vantyra-accent hover:-translate-y-1">
          <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-lg bg-vantyra-accent/10">
            <svg class="h-5 w-5 text-vantyra-accent" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
              <circle cx="10" cy="10" r="4" />
              <line x1="10" y1="1" x2="10" y2="5" />
              <line x1="10" y1="15" x2="10" y2="19" />
              <line x1="1" y1="10" x2="5" y2="10" />
