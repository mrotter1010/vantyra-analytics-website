          <h3 class="text-xl font-semibold text-vantyra-text mb-2">Economic Analysis</h3>
          <p class="text-base text-vantyra-text-s leading-relaxed">
            Sed ut perspiciatis unde omnis iste natus error sit voluptatem accusantium doloremque laudantium, totam rem aperiam.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Validation -->
  <section id="validation" class="fade-in-section scroll-mt-20 bg-vantyra-bg py-12">
    <div class="mx-auto max-w-6xl px-6">
      <div class="section-divider"></div>
      <p class="text-sm uppercase tracking-widest text-vantyra-accent mb-3">Validation</p>
      <h2 class="text-4xl md:text-5xl font-bold tracking-tight text-vantyra-text mb-4">Validation</h2>
      <p class="text-lg text-vantyra-text-s leading-relaxed max-w-3xl mb-12">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
      </p>

      <!-- Stat cards -->
      <div class="grid gap-8 md:grid-cols-3">
        <div class="card-glow bg-vantyra-bg-s rounded-xl border border-vantyra-border p-6 text-center transition-all duration-200 hover:border-vantyra-accent hover:-translate-y-1">
          <p class="text-5xl md:text-6xl font-bold text-vantyra-accent">&minus;0.3%</p>
          <p class="mt-3 text-sm uppercase tracking-wider text-vantyra-text-s">vs measured (Kersey)</p>
        </div>
        <div class="card-glow bg-vantyra-bg-s rounded-xl border border-vantyra-border p-6 text-center transition-all duration-200 hover:border-vantyra-accent hover:-translate-y-1">
          <p class="text-5xl md:text-6xl font-bold text-vantyra-accent">+3.8%</p>
          <p class="mt-3 text-sm uppercase tracking-wider text-vantyra-text-s">vs measured (Arbuckle)</p>
