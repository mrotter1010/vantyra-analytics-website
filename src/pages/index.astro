        </div>
      </div>

      <!-- Demo -->
      <div class="mt-8">
        <h3 class="text-2xl font-semibold text-vantyra-text">Demo</h3>
        <p class="mt-2 text-sm text-vantyra-text-s">See the platform in action</p>
        <div class="mx-auto mt-6 max-w-4xl aspect-video flex items-center justify-center rounded-xl border border-vantyra-border bg-vantyra-bg-s">
          <p class="text-vantyra-text-s">Demo video</p>
        </div>
