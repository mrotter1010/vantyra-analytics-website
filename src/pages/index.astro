---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Vantyra Analytics | Energy analytics consulting">
  <!-- Hero -->
  <section class="relative min-h-screen flex items-center justify-center overflow-hidden -mt-[72px] pt-[72px]">
    <!-- Animated gradient mesh background -->
    <div class="gradient-mesh" aria-hidden="true">
      <div class="gradient-blob gradient-blob-1"></div>
      <div class="gradient-blob gradient-blob-2"></div>
      <div class="gradient-blob gradient-blob-3"></div>
    </div>

    <!-- Static cyan halo behind logo -->
    <div class="logo-halo" aria-hidden="true"></div>

    <!-- Hero content -->
    <div class="relative z-10 flex flex-col items-center px-6 text-center">
      <img
        src="/vantyra-icon.png"
        alt="Vantyra Analytics logo"
        width="160"
        height="160"
        class="mb-8 w-40 h-40"
      />
      <p class="text-sm uppercase tracking-widest text-vantyra-accent mb-4">Energy analytics consulting for generation, storage, and large energy users</p>
      <h1 class="text-5xl font-bold tracking-tight text-vantyra-text max-w-3xl">
        Energy analytics for the decisions you can't afford to get wrong.
      </h1>
      <p class="mt-6 max-w-xl text-2xl font-semibold text-vantyra-text">
        Whether you generate energy, store and sell it, or pay for it, we build the analysis your decision rests on.
      </p>
      <div class="mt-10 flex items-center gap-4">
        <a
          href="#contact"
          class="rounded-full bg-vantyra-accent px-6 py-3 font-semibold text-vantyra-bg shadow-[0_0_20px_rgba(0,212,255,0.4)] hover:shadow-[0_0_30px_rgba(0,212,255,0.6)] transition-shadow"
        >
          Schedule a Call
        </a>
        <a
          href="#practices"
          class="rounded-full border border-vantyra-border px-6 py-3 font-semibold text-vantyra-text hover:border-vantyra-accent hover:text-vantyra-accent transition-colors"
        >
          See what we do
        </a>
      </div>
    </div>
  </section>

  <!-- Practices -->
  <section id="practices" class="fade-in-section scroll-mt-20 bg-vantyra-bg-s py-12">
    <div class="mx-auto max-w-6xl px-6">
      <div class="section-divider"></div>
      <div class="grid gap-8 md:grid-cols-3">
        <!-- Solar -->
        <a href="#solar" class="card-glow bg-vantyra-bg rounded-xl border border-vantyra-border p-6 transition-all duration-200 hover:border-vantyra-accent hover:-translate-y-1 block">
          <p class="text-sm uppercase tracking-widest text-vantyra-accent mb-2">Solar</p>
          <h3 class="text-xl font-semibold text-vantyra-text mb-2">Solar production and design analytics</h3>
          <p class="text-base text-vantyra-text-s leading-relaxed mb-4">Production modeling, buildable land, and DER design, from a coordinate to a defensible estimate.</p>
          <p class="text-sm font-semibold text-vantyra-accent">Explore this practice &rarr;</p>
        </a>
        <!-- Storage -->
        <a href="#storage" class="card-glow bg-vantyra-bg rounded-xl border border-vantyra-border p-6 transition-all duration-200 hover:border-vantyra-success hover:-translate-y-1 block">
          <p class="text-sm uppercase tracking-widest text-vantyra-success mb-2">Storage and markets</p>
          <h3 class="text-xl font-semibold text-vantyra-text mb-2">Storage and grid-scale analytics</h3>
          <p class="text-base text-vantyra-text-s leading-relaxed mb-4">Battery analysis and optimization, and wholesale market analysis.</p>
          <p class="text-sm font-semibold text-vantyra-success">Explore this practice &rarr;</p>
        </a>
        <!-- Budgeting -->
        <a href="#budgeting" class="card-glow bg-vantyra-bg rounded-xl border border-vantyra-border p-6 transition-all duration-200 hover:border-vantyra-accent-s hover:-translate-y-1 block">
          <p class="text-sm uppercase tracking-widest text-vantyra-accent-s mb-2">Budgeting</p>
          <h3 class="text-xl font-semibold text-vantyra-text mb-2">Energy budgeting and forecasting</h3>
          <p class="text-base text-vantyra-text-s leading-relaxed mb-4">Cost and consumption forecasts for every facility, built from your billing and operational data.</p>
          <p class="text-sm font-semibold text-vantyra-accent-s">Explore this practice &rarr;</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Solar -->
  <section id="solar" class="fade-in-section scroll-mt-20 bg-vantyra-bg py-12">
    <div class="mx-auto max-w-6xl px-6">
      <div class="section-divider"></div>
      <p class="text-sm uppercase tracking-widest text-vantyra-accent mb-3">Solar</p>
      <h2 class="text-4xl md:text-5xl font-bold tracking-tight text-vantyra-text mb-4">Solar production and design analytics</h2>
      <p class="text-lg text-vantyra-text-s leading-relaxed max-w-3xl mb-12">
        From early screening to preconstruction feasibility, we model how a solar project will perform before capital is committed. You get production estimates and design comparisons you can put in front of lenders, partners, and investment committees. Built for distributed generation, with the scale to support utility-scale projects.
      </p>
      <div class="grid gap-8 md:grid-cols-3">
        <div class="card-glow bg-vantyra-bg-s rounded-xl border border-vantyra-border p-6 transition-all duration-200 hover:border-vantyra-accent hover:-translate-y-1">
          <h3 class="text-xl font-semibold text-vantyra-text mb-2">Resource and production modeling</h3>
          <p class="text-base text-vantyra-text-s leading-relaxed">Hourly production estimates from site-specific weather and system design.</p>
        </div>
        <div class="card-glow bg-vantyra-bg-s rounded-xl border border-vantyra-border p-6 transition-all duration-200 hover:border-vantyra-accent hover:-translate-y-1">
          <h3 class="text-xl font-semibold text-vantyra-text mb-2">Buildable land analysis</h3>
          <p class="text-base text-vantyra-text-s leading-relaxed">Usable acreage after constraints, so capacity estimates start from land you can build on.</p>
        </div>
        <div class="card-glow bg-vantyra-bg-s rounded-xl border border-vantyra-border p-6 transition-all duration-200 hover:border-vantyra-accent hover:-translate-y-1">
          <h3 class="text-xl font-semibold text-vantyra-text mb-2">DER design optimization</h3>
          <p class="text-base text-vantyra-text-s leading-relaxed">Compare system designs and sizing to find the configuration that fits the site and the economics.</p>
        </div>
      </div>

      <!-- Platform block -->
      <div class="mt-16">
        <p class="text-sm uppercase tracking-widest text-vantyra-accent mb-3">The Vantyra platform</p>
        <p class="text-base text-vantyra-text-s leading-relaxed max-w-3xl mb-8">
          This practice runs on the Vantyra platform, our own modeling engine for solar and storage. It turns a site location and a few design inputs into hourly production, with the same assumptions applied to every site. Clients who want to run their own scenarios can get platform access.
        </p>
        <div class="grid gap-8 md:grid-cols-2 max-w-5xl mx-auto">
          <!-- Step 1 -->
          <div>
            <p class="text-sm uppercase tracking-widest text-vantyra-accent mb-3">Step 1</p>
            <p class="text-base text-vantyra-text-s leading-relaxed mb-4">
              The platform proposes a structured analysis plan — you approve or refine before anything runs.
            </p>
            <img
              src="/workflow-plan.png"
              alt="Vantyra platform showing a proposed analysis plan awaiting user approval"
              class="w-full h-auto rounded-xl border border-vantyra-border"
              style="box-shadow: 0 0 24px rgba(0, 212, 255, 0.06);"
            />
          </div>
          <!-- Step 2 -->
          <div>
            <p class="text-sm uppercase tracking-widest text-vantyra-accent mb-3">Step 2</p>
            <p class="text-base text-vantyra-text-s leading-relaxed mb-4">
              Approved plans return a full analysis: production estimates, loss breakdown, and downloadable charts.
            </p>
            <img
              src="/workflow-results.png"
              alt="Vantyra platform displaying analysis results with production estimates and charts"
              class="w-full h-auto rounded-xl border border-vantyra-border"
              style="box-shadow: 0 0 24px rgba(0, 212, 255, 0.06);"
            />
          </div>
        </div>
      </div>

      <!-- Validation -->
      <div class="mt-16">
        <p class="text-sm uppercase tracking-widest text-vantyra-accent mb-3">Validation</p>
        <h3 class="text-4xl md:text-5xl font-bold tracking-tight text-vantyra-text mb-4">Estimates you can defend.</h3>
        <p class="text-lg text-vantyra-text-s leading-relaxed max-w-3xl mb-12">
          Production modeling is only useful if it matches reality. PVDAQ sites from NREL's archive — across different geographies and mounting types — have been used to validate platform outputs against measured plant data, with results well within typical engineering tolerances.
        </p>

        <!-- Stat cards -->
        <p class="text-sm uppercase tracking-wider text-vantyra-text-s mb-6">Validation sites</p>
        <div class="grid gap-8 md:grid-cols-3">
          <div class="card-glow bg-vantyra-bg-s rounded-xl border border-vantyra-border p-6 text-center transition-all duration-200 hover:border-vantyra-accent hover:-translate-y-1">
            <p class="text-5xl md:text-6xl font-bold text-vantyra-accent">&minus;0.3%</p>
            <p class="mt-3 text-sm uppercase tracking-wider text-vantyra-text-s">Kersey, CO &bull; 4.7 MW single-axis tracker</p>
          </div>
          <div class="card-glow bg-vantyra-bg-s rounded-xl border border-vantyra-border p-6 text-center transition-all duration-200 hover:border-vantyra-accent hover:-translate-y-1">
            <p class="text-5xl md:text-6xl font-bold text-vantyra-accent">+3.8%</p>
            <p class="mt-3 text-sm uppercase tracking-wider text-vantyra-text-s">Arbuckle, CA &bull; 893 kW fixed-tilt</p>
          </div>
          <div class="card-glow bg-vantyra-bg-s rounded-xl border border-vantyra-border p-6 text-center transition-all duration-200 hover:border-vantyra-accent hover:-translate-y-1">
            <p class="text-5xl md:text-6xl font-bold text-vantyra-accent">7&ndash;10%</p>
            <p class="mt-3 text-sm uppercase tracking-wider text-vantyra-text-s">Closer to measured than PVWatts (both sites)</p>
          </div>
        </div>
        <p class="text-sm italic text-vantyra-text-s text-center mt-6">
          Benchmark methodology follows the NREL SAM validation framework (TP-6A20-61497). Additional site validation in progress.
        </p>
      </div>
    </div>
  </section>

  <!-- Storage -->
  <section id="storage" class="fade-in-section scroll-mt-20 bg-vantyra-bg-s py-12">
    <div class="mx-auto max-w-6xl px-6">
      <div class="section-divider"></div>
      <p class="text-sm uppercase tracking-widest text-vantyra-success mb-3">Storage and markets</p>
      <h2 class="text-4xl md:text-5xl font-bold tracking-tight text-vantyra-text mb-4">Storage and grid-scale analytics</h2>
      <p class="text-lg text-vantyra-text-s leading-relaxed max-w-3xl mb-12">
        Storage economics and market exposure both come down to prices, and prices change by location, hour, and season. We model how a battery would operate against those prices and the tariffs around them, and we analyze wholesale market data for the decisions that depend on it. Clients include owners evaluating a storage project and any organization whose costs or revenues move with the market.
      </p>
      <div class="grid gap-8 md:grid-cols-2">
        <div class="card-glow bg-vantyra-bg rounded-xl border border-vantyra-border p-6 transition-all duration-200 hover:border-vantyra-success hover:-translate-y-1">
          <h3 class="text-xl font-semibold text-vantyra-text mb-2">BESS analysis and optimization</h3>
          <p class="text-base text-vantyra-text-s leading-relaxed">Size and dispatch storage against real prices, tariffs, and site load, so the economics hold up under scrutiny.</p>
        </div>
        <div class="card-glow bg-vantyra-bg rounded-xl border border-vantyra-border p-6 transition-all duration-200 hover:border-vantyra-success hover:-translate-y-1">
          <h3 class="text-xl font-semibold text-vantyra-text mb-2">Wholesale market analysis</h3>
          <p class="text-base text-vantyra-text-s leading-relaxed">Node-level wholesale price history, translated into what it means for a project, a contract, or a budget.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Budgeting -->
  <section id="budgeting" class="fade-in-section scroll-mt-20 bg-vantyra-bg py-12">
    <div class="mx-auto max-w-6xl px-6">
      <div class="section-divider"></div>
      <p class="text-sm uppercase tracking-widest text-vantyra-accent-s mb-3">Budgeting</p>
      <h2 class="text-4xl md:text-5xl font-bold tracking-tight text-vantyra-text mb-4">Energy budgeting and forecasting</h2>
      <p class="text-lg text-vantyra-text-s leading-relaxed max-w-3xl mb-12">
        Energy is hard to budget for across many facilities, each with its own usage pattern and cost drivers. We model each site's billing and operational data in depth to find the trends behind its cost and consumption, and our models can leverage weather normalization, natural gas prices, and other external drivers to sharpen the forecast. We deliver sound, actionable insight your team can use right away: a defensible budget, a realistic range of outcomes, and early warning when a site drifts from plan. We work in regulated and deregulated markets, for a single facility or a full portfolio.
      </p>
      <div class="grid gap-8 md:grid-cols-3">
        <div class="card-glow bg-vantyra-bg-s rounded-xl border border-vantyra-border p-6 transition-all duration-200 hover:border-vantyra-accent-s hover:-translate-y-1">
          <p class="text-sm uppercase tracking-widest text-vantyra-accent-s mb-2">Step 1</p>
          <h3 class="text-xl font-semibold text-vantyra-text mb-2">Share your billing and operational data</h3>
          <p class="text-base text-vantyra-text-s leading-relaxed">Monthly cost and kWh for each site, plus any operational data that drives usage.</p>
        </div>
        <div class="card-glow bg-vantyra-bg-s rounded-xl border border-vantyra-border p-6 transition-all duration-200 hover:border-vantyra-accent-s hover:-translate-y-1">
          <p class="text-sm uppercase tracking-widest text-vantyra-accent-s mb-2">Step 2</p>
          <h3 class="text-xl font-semibold text-vantyra-text mb-2">We model each site</h3>
          <p class="text-base text-vantyra-text-s leading-relaxed">Each site gets its own forecast, built on its own data. That captures what regional or portfolio-level models average away, and gives you clarity and specificity down to the facility.</p>
        </div>
        <div class="card-glow bg-vantyra-bg-s rounded-xl border border-vantyra-border p-6 transition-all duration-200 hover:border-vantyra-accent-s hover:-translate-y-1">
          <p class="text-sm uppercase tracking-widest text-vantyra-accent-s mb-2">Step 3</p>
          <h3 class="text-xl font-semibold text-vantyra-text mb-2">Delivery that fits your workflow</h3>
          <p class="text-base text-vantyra-text-s leading-relaxed">From spreadsheets and workbooks to dashboards that track actuals and send alerts.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- How we deliver -->
  <section id="deliver" class="fade-in-section scroll-mt-20 bg-vantyra-bg-s py-12">
    <div class="mx-auto max-w-6xl px-6">
      <div class="section-divider"></div>
      <p class="text-sm uppercase tracking-widest text-vantyra-accent mb-3">How we deliver</p>
      <h2 class="text-4xl md:text-5xl font-bold tracking-tight text-vantyra-text mb-4">Built around how you work.</h2>
      <p class="text-lg text-vantyra-text-s leading-relaxed max-w-3xl mb-8">
        You work directly with the consultant who builds the analysis, with no handoff to a larger team. Each engagement is scoped around the decision you need to make, and deliverables come in the format your team already uses.
      </p>
      <ul class="list-disc pl-6 space-y-3 text-base text-vantyra-text-s leading-relaxed max-w-3xl">
        <li>Scoped to your decision, not a generic report</li>
        <li>Reports, workbooks, or dashboards, whichever fits your team</li>
        <li>Ongoing updates as new data comes in</li>
      </ul>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="fade-in-section scroll-mt-20 bg-vantyra-bg py-12">
    <div class="mx-auto max-w-6xl px-6">
      <div class="section-divider"></div>
      <p class="text-sm uppercase tracking-widest text-vantyra-accent mb-3">About</p>
      <h2 class="text-4xl md:text-5xl font-bold tracking-tight text-vantyra-text mb-4">Built from inside the industry.</h2>
      <p class="text-lg text-vantyra-text-s leading-relaxed max-w-3xl">
        Vantyra was built by an energy professional who has worked across the whole problem: climate and solar modeling, battery storage and dispatch optimization, wholesale market and tariff analysis, budgeting and forecasting, and building the custom tools and workflow automations behind it all. That range means one consultant for questions that usually take three. Every engagement rests on the same method: real data, rigorous modeling of what drives the result, and assumptions laid out so you can see and challenge them. The point is clarity, so you can focus on taking action.
      </p>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="fade-in-section scroll-mt-20 bg-vantyra-bg-s py-12">
    <div class="mx-auto max-w-6xl px-6">
      <div class="section-divider"></div>
      <p class="text-sm uppercase tracking-widest text-vantyra-accent mb-3">Get in touch</p>
      <h2 class="text-4xl md:text-5xl font-bold tracking-tight text-vantyra-text mb-4">Tell us what you're working on.</h2>
      <p class="text-lg text-vantyra-text-s leading-relaxed max-w-3xl mb-12">
        Evaluating a project, a battery, or next year's energy budget? We'll tell you how we'd approach it.
      </p>

      <!-- Calendly inline widget begin -->
      <div class="calendly-inline-widget" data-url="https://calendly.com/michael-rotter-vantyraanalytics/30min?hide_gdpr_banner=1&background_color=1a1a2e&text_color=e8e8f0&primary_color=00d4ff" style="min-width:320px;height:700px;"></div>
      <script type="text/javascript" src="https://assets.calendly.com/assets/external/widget.js" async></script>
      <!-- Calendly inline widget end -->

      <p class="mt-6 text-center text-vantyra-text-s">
        Or reach us at <a href="mailto:michael.rotter@vantyraanalytics.com" class="text-vantyra-accent hover:underline">michael.rotter@vantyraanalytics.com</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .logo-halo {
    position: absolute;
    top: calc(50% - 60px);
    left: 50%;
    width: 350px;
    height: 350px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(0, 212, 255, 0.18) 0%, transparent 60%);
    z-index: 5;
    pointer-events: none;
  }

  .gradient-mesh {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .gradient-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
  }

  .gradient-blob-1 {
    width: 600px;
    height: 600px;
    background: rgba(0, 212, 255, 0.35);
    top: -10%;
    left: -5%;
    animation: drift-1 18s ease-in-out infinite alternate;
  }

  .gradient-blob-2 {
    width: 500px;
    height: 500px;
    background: rgba(123, 97, 255, 0.35);
    bottom: -10%;
    right: -5%;
    animation: drift-2 20s ease-in-out infinite alternate;
  }

  .gradient-blob-3 {
    width: 400px;
    height: 400px;
    background: rgba(0, 212, 255, 0.2);
    top: 40%;
    left: 50%;
    animation: drift-3 16s ease-in-out infinite alternate;
  }

  @keyframes drift-1 {
    0% { transform: translate(0, 0); }
    100% { transform: translate(80px, 60px); }
  }

  @keyframes drift-2 {
    0% { transform: translate(0, 0); }
    100% { transform: translate(-70px, -50px); }
  }

  @keyframes drift-3 {
    0% { transform: translate(0, 0); }
    100% { transform: translate(-60px, 70px); }
  }
</style>

<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const sections = document.querySelectorAll('.fade-in-section');

  if (prefersReducedMotion) {
    sections.forEach((s) => s.classList.add('visible'));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15 }
    );
    sections.forEach((s) => observer.observe(s));
  }
</script>
