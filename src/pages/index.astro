      <!-- Sample outputs -->
      <div class="mt-12">
        <h3 class="text-2xl font-semibold text-vantyra-text">Sample Outputs</h3>
        <p class="mt-2 text-sm text-vantyra-text-s">Example report generated by the platform</p>
        <div class="mx-auto mt-6 max-w-4xl aspect-video flex items-center justify-center rounded-xl border border-vantyra-border bg-vantyra-bg-s">
